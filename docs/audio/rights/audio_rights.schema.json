{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surveillance-survivor.invalid/schemas/audio-rights-v1.json",
  "title": "Surveillance Survivor Audio Rights Ledger",
  "type": "object",
  "required": ["schema_version", "project", "manifest", "release_intent", "evidence", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "manifest": {"type": "string", "minLength": 1},
    "release_intent": {
      "type": "object",
      "required": ["commercial", "media", "territory", "term"],
      "properties": {
        "commercial": {"type": "boolean"},
        "media": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "territory": {"type": "string", "minLength": 1},
        "term": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "document_type", "issuer", "effective_date", "captured_date", "sha256", "storage_locator", "verification_status"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^SS-AUD-EV-[0-9]{4}-[0-9]{4}$"},
          "document_type": {"type": "string"},
          "issuer": {"type": "string"},
          "effective_date": {"type": "string", "format": "date"},
          "captured_date": {"type": "string", "format": "date"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "storage_locator": {"type": "string"},
          "verification_status": {"enum": ["unverified", "verified", "superseded", "rejected"]},
          "reviewer": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "master_sha256", "source_class", "provider_or_creator", "creation_or_acquisition_date", "rights_status", "evidence_ids", "third_party_ip_review"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_class": {"enum": ["original_human", "commissioned", "ai_generated", "licensed_library", "field_recording", "public_domain", "open_license", "third_party_custom"]},
          "provider_or_creator": {"type": "string", "minLength": 1},
          "creation_or_acquisition_date": {"type": "string", "format": "date"},
          "product_or_model": {"type": ["string", "null"]},
          "plan_or_license": {"type": ["string", "null"]},
          "terms_version": {"type": ["string", "null"]},
          "beta_status": {"enum": ["not_applicable", "confirmed_not_beta", "beta_separately_cleared", "unknown"]},
          "commercial_use": {"enum": ["allowed", "restricted", "not_allowed", "unknown"]},
          "modification": {"enum": ["allowed", "restricted", "not_allowed", "unknown"]},
          "sublicensing": {"enum": ["allowed", "restricted", "not_allowed", "unknown"]},
          "attribution": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "third_party_ip_review": {"enum": ["passed", "review_required", "failed", "unknown"]},
          "rights_status": {"enum": ["draft", "pending_evidence", "review_required", "cleared", "restricted", "blocked", "retired"]},
          "reviewer": {"type": ["string", "null"]},
          "review_date": {"type": ["string", "null"], "format": "date"},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
